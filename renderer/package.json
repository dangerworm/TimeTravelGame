{
  "name": "warped-renderer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Print-ready card generator for Warped — loads the decks/*/cards.json content and renders A4 sheets (with double-sided era cards) for print-to-PDF.",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
